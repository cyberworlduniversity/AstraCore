# AstraCore-owned model slots — server side only
ASTRA_MODEL_A_KEY=replace-with-a-random-astracore-key-a
ASTRA_MODEL_B_KEY=replace-with-a-random-astracore-key-b
ASTRA_MODEL_A_CHECKPOINT=data/checkpoints/astracore-neural-a.json
ASTRA_MODEL_B_CHECKPOINT=data/checkpoints/astracore-neural-b.json

# Server and authentication
ASTRA_HOST=127.0.0.1
ASTRA_PORT=8787
ASTRA_PUBLIC_URL=http://127.0.0.1:8787
ASTRA_SESSION_SECRET=replace-with-a-long-random-secret
ASTRA_ADMIN_EMAIL=ehemanathan143@gmail.com

# AstraCore Supabase Auth — use the publishable/anon key only, never a service-role key
ASTRACORE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
ASTRACORE_SUPABASE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional Google/GitHub OAuth is configured inside Supabase Auth; no AI provider keys belong here.
