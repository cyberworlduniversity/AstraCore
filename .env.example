# AstraCore local model slots
# These are AstraCore-owned server keys. Never expose them in browser code.
ASTRA_MODEL_A_KEY=replace-with-a-random-astracore-key-a
ASTRA_MODEL_B_KEY=replace-with-a-random-astracore-key-b

# Optional separate checkpoints for the two model slots.
# If omitted, both slots use the demo checkpoint.
ASTRA_MODEL_A_CHECKPOINT=data/checkpoints/astracore-demo.json
ASTRA_MODEL_B_CHECKPOINT=data/checkpoints/astracore-demo.json

# Server
ASTRA_HOST=127.0.0.1
ASTRA_PORT=8787
