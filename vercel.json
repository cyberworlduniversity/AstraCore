{
  "rewrites": [
    { "source": "/", "destination": "/web/index.html" },
    { "source": "/auth", "destination": "/web/index.html" },
    { "source": "/login", "destination": "/web/index.html" },
    { "source": "/signup", "destination": "/web/index.html" },
    { "source": "/admin", "destination": "/web/admin.html" },
    { "source": "/auth/google", "destination": "/api/auth/google" },
    { "source": "/auth/google/callback", "destination": "/api/auth/google/callback" },
    { "source": "/auth/github", "destination": "/api/auth/github" },
    { "source": "/auth/github/callback", "destination": "/api/auth/github/callback" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
